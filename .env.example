# Copia a .env en la raíz del repo.

COMPANY_NAME=Synckre
ENV=dev

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=langgraph_db
POSTGRES_URI=postgresql://postgres:postgres@postgres:5432/langgraph_db

PUBLIC_API_KEY=synckre-pub-key-2026
INTERNAL_API_KEY=synckre-int-key-2026
ADMIN_API_KEY=synckre-admin-key-2026

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost:4321,http://127.0.0.1:4321

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE_PUBLIC=synckre-public
TEMPORAL_NAMESPACE_INTERNAL=synckre-internal
TASK_QUEUE_PUBLIC=synckre-public
TASK_QUEUE_INTERNAL=synckre-internal

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
TOP_K=2

# Tools públicas (solo el worker público debe tenerlas en runtime)
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Aviso interno de nuevos prospectos (emails separados por coma)
EMAIL_INTERNAL_TO=

# ERPNext opcional. Si falta, el prospecto queda en Postgres (tabla prospectos).
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=


