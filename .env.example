# ============================================================
# .env.example — PLANTILLA (sin secretos reales)
# Copia este archivo a tu .env real y rellena cada valor.
# NUNCA commitees claves reales (GitHub bloquea el push).
# Genera claves con: openssl rand -hex 32
# ============================================================

# --- Entorno / App ---
ENV=production
COMPANY_NAME=Synckre

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=sk-cambia-esta-clave
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com


# --- Frontend / Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cambia_esta_clave_publica
CLERK_SECRET_KEY=sk_test_cambia_esta_clave_secreta
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# --- Frontend / CORS ---
# El navegador usa same-origin (/api/v1 via Next.js). NEXT_PUBLIC_API_URL ya no es
# necesario en cliente; API_URL es el backend que el proxy llama en servidor.
NEXT_PUBLIC_API_URL=https://agent.synckre.com
API_URL=https://agent.synckre.com
ALLOWED_ORIGINS=https://control-ai.synckre.com,https://www.synckre.com,https://synckre.com,http://localhost:3000,http://localhost:8000

# --- Base de datos (PostgreSQL con pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=synckre_agent_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URI completa y concreta (Coolify: sin ${...})
POSTGRES_URI=postgresql://postgres:cambia-esta-password@postgres:5432/synckre_agent_db

# --- RAG / Ollama ---
OLLAMA_BASE_URL=https://ollama.synckre.com
EMBEDDING_MODEL=qwen3-embedding:0.6b
TOP_K=4

# --- Email (Resend) ---
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@synckre.com
RESEND_API_KEY=re_cambia-esta-clave

# --- ERPNext (opcional) ---
ERPNEXT_URL=https://erp.synckre.com
ERPNEXT_API_KEY=cambia-esta-key
ERPNEXT_API_SECRET=cambia-este-secret
ERPNEXT_GOOGLE_CALENDAR=

# --- Calendar (fallback Google) ---
GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Recordatorios de citas ---
REMINDER_POLL_SECONDS=60
APPOINTMENT_REMINDER_MINUTES=15