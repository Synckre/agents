# ============================================================================
# Synckre Agent — variables de entorno
# Desarrollo local:  cp .env.example .env
# Producción (Coolify): configura cada variable en la UI del servicio.
# Sin valores reales aquí; todas las secrets se leen desde el entorno.
# ============================================================================

# --- Secretos requeridos (fail-fast al arrancar si faltan) ---

# API key de DeepSeek (https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=

# API keys válidas para el header X-API-Key, separadas por coma.
# Soporta varias a la vez para rotar sin downtime:
#   API_KEYS=key-actual,key-nueva
API_KEYS=

# Connection string de Postgres para el checkpointer del estado.
#   Local (host):  postgresql://usuario:pass@localhost:5432/synckre
#   Coolify:       postgresql://usuario:pass@postgres:5432/synckre
#                  (host = nombre del servicio postgres en el compose)
DATABASE_URL=

# Opcional: tracing en LangSmith. Vacío = desactivado.
LANGSMITH_API_KEY=

# --- Entorno ---

# development | production
# production desactiva /docs, /redoc y /openapi.json, y oculta el detalle de
# errores al cliente (respuesta neutra).
APP_ENV=development

# --- Seguridad ---

# Orígenes CORS permitidos, separados por coma (p. ej. https://app.midominio.com).
# Vacío = sin CORS. NUNCA "*" en producción.
CORS_ORIGINS=

# Hosts permitidos por TrustedHostMiddleware, separados por coma.
# Acepta URLs completas (https://... ) y las normaliza quitando esquema/puerto.
# En Coolify usa la variable mágica del dominio: SERVICE_URL_<NOMBRE>_8000
TRUSTED_HOSTS=localhost,127.0.0.1

# IPs de los proxies de confianza para X-Forwarded-* (uvicorn ProxyHeadersMiddleware).
# En Coolify: la subred del proxy interno (Traefik), p. ej. 172.17.0.0/16.
# Nunca 0.0.0.0/0: confiar en X-Forwarded-* solo desde el proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Rate limit por API key (slowapi). Formato: N/unidad (20/minute, 100/hour).
RATE_LIMIT=20/minute

# Límite máximo de body por request en bytes (1 MB por defecto).
BODY_LIMIT_BYTES=1000000

# Timeout (segundos) de cada llamada al LLM.
LLM_TIMEOUT_SECONDS=60

# Longitud máxima del campo "mensaje" en /invoke y /stream.
MAX_MENSAJE_LENGTH=4000

# Backend del checkpointer: postgres (producción) | memory (solo tests).
CHECKPOINTER_BACKEND=postgres

# Expone el grafo como runtime CopilotKit en /copilotkit (true|false).
# El endpoint es público (la UI de CopilotKit no envía X-API-Key); en
# producción protégelo en el proxy si no vas a usarlo.
COPILOTKIT_ENABLED=true

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Credenciales de Postgres usadas por docker-compose ---

POSTGRES_USER=synckre
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=synckre

# --- Coolify (variable mágica, la inyecta Coolify automáticamente) ---
# Contiene el dominio público del servicio; se usa como TRUSTED_HOSTS por
# defecto. El nombre depende del servicio en Coolify:
#   SERVICE_URL_<NOMBRE>_8000  (p. ej. SERVICE_URL_SYNCKRE_8000 si el
#   servicio se llama "synckre"). Si tu servicio tiene otro nombre, ajusta
#   TRUSTED_HOSTS en la UI.
# SERVICE_URL_SYNCKRE_8000=
