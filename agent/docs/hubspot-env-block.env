# =============================================================================
# HubSpot — variables que hay que configurar en AgentSynckre
# =============================================================================
# Son SOLO estas. Todo lo demás (versión de API, objeto de citas, tipos de
# asociación, caudal, timeouts) son constantes verificadas contra el portal y
# viven en `src/config/hubspot.config.ts`.
#
# Referencia: docs/hubspot-runbook.md
# =============================================================================

# --- Proveedor de CRM --------------------------------------------------------
# OJO: si se OMITE, el default es 'hubspot' y, sin token, el proceso NO arranca.
# Rollback: 'erpnext' + restaurar ERPNEXT_URL/API_KEY/API_SECRET.
CRM_PROVIDER=hubspot

# 'live' escribe en el CRM | 'dry_run' no toca el portal (solo logs).
CRM_WRITE_MODE=live

# --- Credencial de HubSpot (la única) ---------------------------------------
# HubSpot > Settings > Integrations > Private Apps.
# Scopes necesarios:
#   crm.objects.contacts.read        buscar y leer contactos
#   crm.objects.contacts.write       crear/actualizar contactos y notas
#   crm.objects.notes.read           leer notas
#   crm.objects.appointments.read    leer citas (disponibilidad y dedupe)
#   crm.objects.appointments.write   crear/reprogramar/cancelar citas
#   crm.schemas.contacts.write       crear las propiedades synckre_* de contacto
#   crm.schemas.appointments.write   crear las propiedades de la cita
HUBSPOT_PRIVATE_APP_TOKEN=

# Host de la API. Solo hace falta cambiarlo para data residency EU.
# HUBSPOT_API_BASE_URL=https://api.hubapi.eu

# =============================================================================
# Política de agendamiento
# =============================================================================
# FUENTE DE VERDAD: la base de datos (tablas scheduling_*), editable desde un panel.
#   npm run scheduling:show / npm run scheduling:seed
# Estas variables son SOLO la semilla inicial y el respaldo si la BD está vacía.
# =============================================================================
SCHEDULING_TIMEZONE=America/New_York
# IMPORTANTE: usa el formato compacto de esta plantilla, NO JSON.
# Los paneles de despliegue (Coolify, Compose, Kubernetes) suelen perder las
# comillas dobles del JSON y el proceso fallaba al arrancar. El formato compacto
# no lleva comillas, llaves ni comas anidadas, así que sobrevive a cualquier panel.
# Si el valor llega mal formado, ahora solo se avisa y se sigue con la política de
# la base de datos: no tumba el servicio.
SCHEDULING_BUSINESS_HOURS=mon=09:00-18:00,tue=09:00-18:00,wed=09:00-18:00,thu=09:00-18:00,fri=09:00-18:00,sat=closed,sun=closed
SCHEDULING_APPOINTMENT_TYPES=general=30:Reunión General,consultation=45:Consultoría Técnica,demo=30:Demostración de Producto
SCHEDULING_MAX_APPOINTMENTS_PER_DAY=8
SCHEDULING_SLOT_INTERVAL_MINUTES=30
SCHEDULING_HOLIDAYS=2026-01-01,2026-01-19,2026-02-16,2026-05-25,2026-06-19,2026-07-04,2026-09-07,2026-10-12,2026-11-11,2026-11-26,2026-12-25
