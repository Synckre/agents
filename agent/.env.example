# Application Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# LLM Provider Configuration
LLM_PROVIDER=deepseek
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2

# Memory / Persistence (Neon + pgvector). Coolify: set DATABASE_URL from the Neon dashboard.
# Use the pooled connection string. Enable the vector extension on the Neon project.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Chatbox security
# Local: Vite/Astro origins. Coolify: Vercel production + preview if needed.
CORS_ORIGIN=http://localhost:4321,http://localhost:4322,http://localhost:3000
# CORS_ORIGIN=https://www.synckre.com,https://synckre.com
SESSION_SECRET=change-me-to-a-long-random-string
# SYNCKRE_API_KEY=replace-with-a-long-random-secret
# Must match the same value on the marketing site (server-only).
SYNCKRE_API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# =============================================================================
# CRM
# =============================================================================
# Proveedor activo. OJO: si se OMITE, el valor por defecto es 'hubspot' y, sin
# token, el proceso NO arranca (fail-fast deliberado).
# Rollback a ERPNext: pon 'erpnext' y restaura ERPNEXT_URL/API_KEY/API_SECRET.
CRM_PROVIDER=hubspot

# 'live' escribe en el CRM | 'dry_run' registra la intención sin tocar el portal.
CRM_WRITE_MODE=live

# --- HubSpot -----------------------------------------------------------------
# ÚNICA credencial necesaria: Private App access token.
# HubSpot > Settings > Integrations > Private Apps. Scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.notes.read,
#   crm.objects.appointments.read, crm.objects.appointments.write,
#   crm.schemas.contacts.write, crm.schemas.appointments.write
HUBSPOT_PRIVATE_APP_TOKEN=

# El resto de parámetros de HubSpot (versión de API, objeto de citas, tipos de
# asociación, límites de caudal y timeouts) son constantes verificadas contra el
# portal y viven en `src/config/hubspot.config.ts`.

# =============================================================================
# Política de agendamiento
# =============================================================================
# FUENTE DE VERDAD: la base de datos (tablas scheduling_*), pensada para poder
# editarse desde un panel de configuración.
#   npm run scheduling:show    # política vigente y su origen
#   npm run scheduling:seed    # volcar estos valores a la BD (solo si no existe)
#
# Estas variables son SOLO la semilla inicial y el respaldo mientras la BD no
# tenga política. Una vez sembrada, la BD manda y cambiar esto no surte efecto.
# =============================================================================
SCHEDULING_TIMEZONE=America/New_York
# Horario comercial por día. null = cerrado.
SCHEDULING_BUSINESS_HOURS={"mon":{"open":"09:00","close":"18:00"},"tue":{"open":"09:00","close":"18:00"},"wed":{"open":"09:00","close":"18:00"},"thu":{"open":"09:00","close":"18:00"},"fri":{"open":"09:00","close":"18:00"},"sat":null,"sun":null}
# Tipos de cita: duración en minutos y concurrencia.
SCHEDULING_APPOINTMENT_TYPES={"general":{"name":"Reunión General","durationMinutes":30,"maxConcurrent":1},"consultation":{"name":"Consultoría Técnica","durationMinutes":45,"maxConcurrent":1},"demo":{"name":"Demostración de Producto","durationMinutes":30,"maxConcurrent":1}}
# Festivos en ISO YYYY-MM-DD separados por coma.
SCHEDULING_HOLIDAYS=2026-01-01,2026-01-19,2026-02-16,2026-05-25,2026-06-19,2026-07-04,2026-09-07,2026-10-12,2026-11-11,2026-11-26,2026-12-25
SCHEDULING_MAX_APPOINTMENTS_PER_DAY=8
SCHEDULING_SLOT_INTERVAL_MINUTES=30
SCHEDULING_POLICY_CACHE_TTL_MS=600000

# googleapis (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Google Drive Knowledge Base Sync
GOOGLE_DRIVE_PUBLIC_FOLDER_ID=
GOOGLE_DRIVE_INTERNAL_FOLDER_ID=
KNOWLEDGE_SYNC_INTERVAL_MINUTES=180

# Resend
RESEND_API_KEY=
EMAIL_FROM=Synckre <chat@example.com>
INTERNAL_ALERT_EMAIL=ops@example.com

# Ollama embeddings (RAG)
# En Docker Compose la app usa http://ollama:11434 (se pisa en environment).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
